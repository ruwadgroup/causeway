{
  "name": "@causewayjs/solid",
  "version": "0.1.1-alpha.0",
  "description": "SolidJS resource bindings (query, mutation, subscription) for causeway-generated clients.",
  "keywords": [
    "python",
    "rpc",
    "solid",
    "solidjs",
    "sse",
    "streaming",
    "causeway"
  ],
  "homepage": "https://github.com/tamimbinhakim/causeway#readme",
  "bugs": {
    "url": "https://github.com/tamimbinhakim/causeway/issues"
  },
  "license": "MIT",
  "author": "Tamim Bin Hakim (@tamimbinhakim)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tamimbinhakim/causeway.git",
    "directory": "packages/causeway-solid"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "clean": "rimraf dist .turbo"
  },
  "devDependencies": {
    "@types/node": "25.7.0",
    "@causewayjs/client": "workspace:*",
    "happy-dom": "20.9.0",
    "solid-js": "1.9.12",
    "tsdown": "0.22.2",
    "vite": "8.0.12",
    "vite-plugin-solid": "2.11.12",
    "vitest": "4.1.6"
  },
  "peerDependencies": {
    "@causewayjs/client": ">=0.1.0-alpha.0 <0.2.0",
    "solid-js": ">=1.8.0 <2"
  },
  "engines": {
    "node": ">=20"
  }
}
