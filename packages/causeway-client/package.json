{
  "name": "@causewayjs/client",
  "version": "1.0.0-alpha.0",
  "description": "Route-key Causeway client runtime with owned cache, mutations, refreshes, and hydration.",
  "keywords": [
    "python",
    "rpc",
    "typescript",
    "causeway"
  ],
  "homepage": "https://github.com/ruwadgroup/causeway#readme",
  "bugs": {
    "url": "https://github.com/ruwadgroup/causeway/issues"
  },
  "license": "MIT",
  "author": "Tamim Bin Hakim (@tamimbinhakim)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruwadgroup/causeway.git",
    "directory": "packages/causeway-client"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@causewayjs/ts": "workspace:1.0.0-alpha.0"
  },
  "devDependencies": {
    "@types/node": "25.9.3",
    "tsdown": "0.22.2",
    "vite": "8.0.16",
    "vitest": "4.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
